{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/Main.dc.html"
    },
    {
      "source": "/collection",
      "destination": "/collection.html"
    },
    {
      "source": "/atelier",
      "destination": "/atelier.html"
    },
    {
      "source": "/works",
      "destination": "/Projects.dc.html"
    },
    {
      "source": "/3d-studio",
      "destination": "/3d-studio.html"
    },
    {
      "source": "/collection/:slug",
      "destination": "/api/page?kind=product&scope=collection&slug=:slug"
    },
    {
      "source": "/atelier/:slug",
      "destination": "/api/page?kind=product&scope=atelier&slug=:slug"
    },
    {
      "source": "/works/:slug",
      "destination": "/api/page?kind=work&slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/page?kind=blog"
    },
    {
      "source": "/blog/category/:cat",
      "destination": "/api/page?kind=blog&cat=:cat"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?kind=post&slug=:slug"
    },
    {
      "source": "/invest",
      "destination": "/api/page?kind=invest"
    },
    {
      "source": "/invest/:slug",
      "destination": "/api/page?kind=model&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/:path*",
      "destination": "/api/go?path=:path*"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "{product,work,blog,invest,404}.html"
    },
    "api/go.js": {
      "includeFiles": "404.html"
    }
  },
  "redirects": [
    {
      "source": "/configure",
      "destination": "/3d-studio.html",
      "permanent": false
    },
    {
      "source": "/Configurator.dc.html",
      "destination": "/3d-studio.html",
      "permanent": true
    },
    {
      "source": "/store",
      "destination": "/atelier.html",
      "permanent": false
    },
    {
      "source": "/design-studio",
      "destination": "/3d-studio.html",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/my-builds",
      "destination": "/Portal.dc.html",
      "permanent": false
    },
    {
      "source": "/design-manager",
      "destination": "/design-manager.html",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/studio.html",
      "permanent": false
    },
    {
      "source": "/2x4",
      "destination": "/2x4.html",
      "permanent": false
    },
    {
      "source": "/Opportunities.dc.html",
      "destination": "/invest",
      "permanent": true
    },
    {
      "source": "/Invest.dc.html",
      "destination": "/invest",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_blob/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ds-package.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
