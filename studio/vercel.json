{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/Main.dc.html"
    }
  ],
  "redirects": [
    {
      "source": "/collection",
      "destination": "/collection.html",
      "permanent": false
    },
    {
      "source": "/atelier",
      "destination": "/atelier.html",
      "permanent": false
    },
    {
      "source": "/configure",
      "destination": "/3d-studio.html",
      "permanent": false
    },
    {
      "source": "/Configurator.dc.html",
      "destination": "/3d-studio.html",
      "permanent": true
    },
    {
      "source": "/store",
      "destination": "/atelier.html",
      "permanent": false
    },
    {
      "source": "/works",
      "destination": "/Projects.dc.html",
      "permanent": false
    },
    {
      "source": "/design-studio",
      "destination": "/3d-studio.html",
      "permanent": false
    },
    {
      "source": "/3d-studio",
      "destination": "/3d-studio.html",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/my-builds",
      "destination": "/Portal.dc.html",
      "permanent": false
    },
    {
      "source": "/design-manager",
      "destination": "/design-manager.html",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/studio.html",
      "permanent": false
    },
    {
      "source": "/2x4",
      "destination": "/2x4.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_blob/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ds-package.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
