# Copy to .env — never commit real values. Production values come from the secrets vault.
NODE_ENV=development
PORT=4000
PUBLIC_WEB_ORIGIN=http://localhost:3000

# Supabase project: firmplant-dev (ref ehccupredtuvmajsahly, eu-central-1)
# Get the password from Supabase → Project Settings → Database.
DATABASE_URL=postgresql://postgres.ehccupredtuvmajsahly:[DB_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.ehccupredtuvmajsahly:[DB_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-64-random-bytes
SESSION_TTL_HOURS=168

STORAGE_BUCKET=firmplant-dev
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

EMAIL_PROVIDER=console        # console | smtp | ses | postmark
SMS_PROVIDER=console          # console | africastalking | twilio
WHATSAPP_PROVIDER=console     # console | meta-cloud
AI_PROVIDER=none              # none | anthropic | openai
PAYMENT_PROVIDER=none
MAP_PROVIDER=none
ANALYTICS_ID=

FX_SOURCE=manual
TRADE_DATA_ADAPTER=mock       # mock | csv | comtrade
SENTRY_DSN=
